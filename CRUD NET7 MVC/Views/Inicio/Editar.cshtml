@model CRUD_NET7_MVC.models.Contacto
@{
    ViewData["Title"] = "editar contacto";
}

<h1>Crear contacto</h1>
<div class="row">
    <div class="offset-9 col-3 mb-3">
        <a asp-action="crear" asp-controller="Inicio" class="btn-secondary d-block mx-auto btn-lg"> <i class="bi bi-file-plus-fill"</i>Nuevo Usuario</a>
    </div>
</div>

<div class="row">
    <div class="offset-12">
        <div class="card border">
            <div class="card-header bg-dark">
                <h3 class="text-white"><strong>editar usuarios</strong></h3>
            </div>
            <div class="card-body">
                <form asp-action="Editar" method="post">

                    <!--ID DEL USUARIO-->
					<input type="hidden" asp-for="id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Nombre" class="control-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingresa el nombre" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Telefono" class="control-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ingresa el Telefono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Movil" class="control-label"></label>
                        <input asp-for="Movil" class="form-control" placeholder="Ingresa el Movil" />
                        <span asp-validation-for="Movil" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ingresa el Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary d-block mx-auto"><i class="bi bi-pencil-filll"</i>editar contacto</button>
                    </div>
                </form>
                <a asp-controller="Inicio" asp-action="Index">volver</a>

            </div>
        </div>
    </div>
</div>
